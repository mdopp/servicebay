---
# Authelia Configuration
# Generated by ServiceBay — edit via ServiceBay or this file directly

theme: dark

server:
  address: 'tcp://0.0.0.0:{{AUTHELIA_PORT}}'

log:
  level: info

jwt_secret: '{{AUTHELIA_JWT_SECRET}}'

authentication_backend:
  ldap:
    address: 'ldap://{{LLDAP_HOST}}:{{LLDAP_LDAP_PORT}}'
    base_dn: '{{LLDAP_BASE_DN}}'
    additional_users_dn: 'ou=people'
    users_filter: '(&(|({username_attribute}={input})({mail_attribute}={input}))(objectClass=person))'
    additional_groups_dn: 'ou=groups'
    groups_filter: '(member={dn})'
    user: 'uid=admin,ou=people,{{LLDAP_BASE_DN}}'
    password: '{{LLDAP_ADMIN_PASSWORD}}'
    attributes:
      username: 'uid'
      display_name: 'displayName'
      mail: 'mail'
      group_name: 'cn'

session:
  secret: '{{AUTHELIA_SESSION_SECRET}}'
  # Session lifetime — a deliberate operator trade-off, not an oversight (#2830).
  # Authelia's built-in defaults (expiration 1h, inactivity 5m) signed residents
  # out of a household dashboard every five minutes of not touching it. The
  # operator chose "practically never has to sign in again": at a one-month
  # session the phone's DEVICE LOCK is the effective protection in front of
  # Solaris — door lock and garage door included — not the Authelia login.
  # Decided 2026-09-06; do not "correct" this back to the defaults.
  #
  # inactivity is 1M and NOT 0: Authelia resets any `inactivity <= 0` to its
  # 5-minute default while validating the config
  # (internal/configuration/validator/session.go, v4.39.x), so 0 would silently
  # restore exactly the symptom above. Matching inactivity to expiration is what
  # actually retires the inactivity logout.
  expiration: '1M'
  inactivity: '1M'
  remember_me: '1M'
  cookies:
    - domain: '{{PUBLIC_DOMAIN}}'
      authelia_url: 'https://auth.{{PUBLIC_DOMAIN}}'
      # Fallback landing page for a portal-direct login (logout then login,
      # no originating `rd` param) — otherwise the user sits on the portal
      # after 1FA/2FA. Targets a `*.{{PUBLIC_DOMAIN}}` subdomain that is
      # one_factor/group:family under the wildcard access_control rule, so the
      # signed-in user is authorized. NOT the bare apex (ADR 0006: apex is
      # default-deny → 403). App-originated logins with `rd` still honour `rd`;
      # this is only the no-`rd` fallback (non-regressive).
      default_redirection_url: 'https://www.{{PUBLIC_DOMAIN}}/'

storage:
  encryption_key: '{{AUTHELIA_STORAGE_ENCRYPTION_KEY}}'
  local:
    path: '/data/db.sqlite3'

notifier:
  filesystem:
    filename: '/data/notification.txt'

access_control:
  default_policy: deny
  rules:
    # Authelia portal — must be publicly accessible
    - domain: 'auth.{{PUBLIC_DOMAIN}}'
      policy: bypass

    # Admin services — admins group, two-factor.
    - domain:
        - 'admin.{{PUBLIC_DOMAIN}}'
        - 'nginx.{{PUBLIC_DOMAIN}}'
        - 'dns.{{PUBLIC_DOMAIN}}'
        - 'ldap.{{PUBLIC_DOMAIN}}'
      policy: two_factor
      subject:
        - 'group:admins'

    # Explicit deny on admin domains for any subject that didn't match
    # the rule above. Without this, a `family`-only user reaches these
    # hosts via the wildcard rule below — Authelia evaluates rules top-
    # to-bottom and a `subject` mismatch SKIPS the rule rather than
    # denying. (#878 follow-up — the access_control table looked
    # restrictive but actually let family users into LLDAP / NPM / AdGuard.)
    - domain:
        - 'admin.{{PUBLIC_DOMAIN}}'
        - 'nginx.{{PUBLIC_DOMAIN}}'
        - 'dns.{{PUBLIC_DOMAIN}}'
        - 'ldap.{{PUBLIC_DOMAIN}}'
      policy: deny

    # Everything else — family + admins, one-factor
    - domain: '*.{{PUBLIC_DOMAIN}}'
      policy: one_factor
      subject:
        - 'group:family'
        - 'group:admins'

identity_providers:
  oidc:
    hmac_secret: '{{AUTHELIA_OIDC_HMAC_SECRET}}'
    jwks:
      # Authelia 4.39 requires a real RSA key inline; key_path under jwks is
      # not yet supported in 4.39.x. ServiceBay generates a 2048-bit key at
      # install time and the wizard pre-indents it with 10 spaces so the
      # block scalar below renders as valid YAML.
      - key_id: 'main'
        algorithm: 'RS256'
        use: 'sig'
        key: |
{{{AUTHELIA_OIDC_RSA_PRIVATE_KEY}}}
    clients:
      - client_id: 'servicebay'
        client_name: 'ServiceBay'
        client_secret: '$plaintext${{SERVICEBAY_OIDC_SECRET}}'
        public: false
        authorization_policy: 'two_factor'
        redirect_uris:
          - 'https://admin.{{PUBLIC_DOMAIN}}/api/auth/oidc/callback'
        scopes:
          - 'openid'
          - 'profile'
          - 'email'
          - 'groups'
        # 'groups' claim is delivered automatically when the 'groups' scope is
        # requested — no client-level claim mapping needed in 4.39+.
        response_types:
          - 'code'
        grant_types:
          - 'authorization_code'
        token_endpoint_auth_method: 'client_secret_post'
      # Additional OIDC clients are declared by their respective service templates
