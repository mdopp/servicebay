# Home Assistant base config. ServiceBay writes this once on first
# install. Edit freely afterwards — re-deploys don't overwrite.
#
# That promise is enforced since #2597 by `servicebay.seed-only-configs`
# in template.yml: the deploy writes this file only when it is absent.
# Before that annotation it was prose only, and every deploy re-rendered
# the file over whatever the operator had added.
#
# Two values in here still belong to ServiceBay and would otherwise go
# stale the moment this file stopped being re-rendered: the auth_oidc
# `client_secret` and `discovery_url` (plus the two role groups). Those
# are reconciled key-by-key from post-deploy.py on every deploy — see
# `ensure_auth_oidc_config_block()` — so a rotated HA_OIDC_SECRET or a
# changed PUBLIC_DOMAIN still reaches Home Assistant. Everything else in
# this file is yours.
#
# Reverse-proxy trust list: deliberately NOT here. Home Assistant
# 2026.8 moved the `http:` integration out of YAML and into its own
# store (Settings → System → Network), and raises a permanent repair
# issue — "HTTP YAML configuration is ignored after migration" — for
# as long as an `http:` block is still in this file. ServiceBay now
# sets `use_x_forwarded_for` + `trusted_proxies` through HA's own
# `http/config/configure` websocket command from post-deploy.py
# instead, so the setting lands where HA actually reads it and the
# repair issue stays cleared (#2573).
#
# Backup-restore caveat: when you restore a HA backup, the snapshot's
# own configuration.yaml replaces this file — but the HTTP settings
# live in `.storage/http`, not here, so the trust list survives. The
# `auth_oidc:` block below does not; post-deploy.py re-appends it.

# Loads default set of integrations. Do not remove.
default_config:

# UI-editable automations / scripts / scenes live in their own files.
# Without these three `!include` lines a restored `automations.yaml`
# (or `scripts.yaml` / `scenes.yaml`) is NEVER loaded — every automation
# shows up `unavailable` after a backup-restore (#1687). The companion
# files are created empty on first install; ServiceBay re-adds any of
# these include lines on deploy when it finds them missing (e.g. after a
# restore that brought back a user `configuration.yaml` without them).
automation: !include automations.yaml
script: !include scripts.yaml
scene: !include scenes.yaml

# OIDC auth via the `auth_oidc` custom component (installed by
# post-deploy.py from a pinned tarball — see HA_OIDC_AUTH_VERSION).
# HA core has no native OIDC provider yet, so this is the bridge.
# Restart HA after first install for the integration to register the
# `/auth/oidc/*` endpoints; subsequent re-deploys skip the reinstall
# when the version stamp on disk already matches HA_OIDC_AUTH_VERSION.
#
# post-deploy.py owns the VALUES below from here on (#2597): it rewrites
# `client_secret` / `discovery_url` / the two role groups in place when
# the deploy's env differs from what is on disk, and restarts HA when it
# does. It only ever touches those keys — anything you add to this block
# stays. Delete a key and ServiceBay leaves it deleted rather than
# re-inventing your structure; it says so in the deploy log.
auth_oidc:
  client_id: homeassistant
  client_secret: {{HA_OIDC_SECRET}}
  discovery_url: https://auth.{{PUBLIC_DOMAIN}}/.well-known/openid-configuration
  features:
    # LLDAP-side `sub` claim auto-binds to the matching HA user record
    # on first SSO login, so existing local accounts don't get
    # duplicated.
    automatic_user_linking: true
    # Auto-create a `person` entity for new SSO users — without this
    # the HA UI shows the user as unattached and dashboards filtered
    # by `person.*` skip them.
    automatic_person_creation: true
  roles:
    admin: "{{HA_OIDC_ADMIN_GROUP}}"
    user:  "{{HA_OIDC_USER_GROUP}}"
